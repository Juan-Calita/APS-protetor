# ===========================================================================
#  Pipeline de ectoscopia clínica — configuração
#  Copie para `.env` e preencha. Nunca versione o `.env` real.
# ===========================================================================

# --- Google Veo 3.1 (google-genai) -----------------------------------------
# Chave do Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# veo-3.1-fast-generate-preview (mais rápido/barato) ou veo-3.1-generate-preview
VEO_MODEL=veo-3.1-fast-generate-preview

# ATENÇÃO: o Veo 3.x aceita apenas 16:9 e 9:16 — não existe 1:1 nativo.
# Pedimos 16:9 em 720p e o FFmpeg faz o center-crop para 720x720 (1:1 exato).
# Se a API passar a aceitar 1:1, basta trocar aqui — há fallback automático.
VEO_ASPECT_RATIO=16:9
VEO_RESOLUTION=720p

# Durações aceitas pelo Veo 3.1 são discretas (tipicamente 4, 6, 8 s).
# Qualquer valor >= 4 s satisfaz o corte [2s,4s) + [0s,2s) do pós-processamento.
VEO_DURATION_SECONDS=6
VEO_PERSON_GENERATION=allow_adult

# Polling e retentativas
VEO_POLL_INTERVAL=10
VEO_POLL_TIMEOUT=900
VEO_MAX_ATTEMPTS=5
VEO_BACKOFF_BASE=8
VEO_BACKOFF_MAX=300
VEO_COOLDOWN_BETWEEN_CALLS=3

# --- FFmpeg / pós-processamento --------------------------------------------
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
OUT_SIZE=720
OUT_FPS=24
SEGMENT_SECONDS=2.0
CROSSFADE_SECONDS=0.5
CRF_START=27
CRF_MAX=40
CRF_STEP=3
X264_PRESET=slow
MAX_MP4_KB=600
POSTER_Q_START=4
POSTER_Q_MAX=12
MAX_POSTER_KB=60

# --- Google Drive ----------------------------------------------------------
DRIVE_ENABLED=1
DRIVE_AUTH_MODE=service_account          # service_account | oauth
DRIVE_SERVICE_ACCOUNT_FILE=service_account.json
DRIVE_OAUTH_CLIENT_FILE=client_secret.json
DRIVE_OAUTH_TOKEN_FILE=drive_token.json
DRIVE_ROOT_PATH=medical-assets/ectoscopia

# OBRIGATÓRIO com service_account: Service Accounts não têm cota de
# armazenamento própria. Informe UMA das duas opções abaixo.
#   - DRIVE_ROOT_PARENT_ID : id de uma pasta do seu Meu Drive compartilhada
#     com o e-mail da SA como Editor. O id está na URL da pasta:
#     https://drive.google.com/drive/folders/<ESTE_É_O_ID>
#   - DRIVE_SHARED_DRIVE_ID: id de um Drive compartilhado onde a SA é membro.
DRIVE_ROOT_PARENT_ID=
DRIVE_SHARED_DRIVE_ID=

# 1 = concede leitura a "qualquer pessoa com o link" nos arquivos enviados.
# Mantenha 0 se a política do domínio proibir links públicos.
DRIVE_MAKE_PUBLIC=0
DRIVE_MAX_ATTEMPTS=5

# --- Planilha de controle ---------------------------------------------------
TRACKER_BACKEND=excel                    # excel | sheets | none
EXCEL_PATH=controle_producao_ectoscopia.xlsx

# Somente para TRACKER_BACKEND=sheets. O id está na URL da planilha:
# https://docs.google.com/spreadsheets/d/<ESTE_É_O_ID>/edit
# Compartilhe a planilha com o e-mail da Service Account como Editor.
SHEETS_SPREADSHEET_ID=
SHEETS_WORKSHEET=Producao
SHEETS_CREDENTIALS_FILE=service_account.json

# --- Execução ---------------------------------------------------------------
WORK_DIR=build
TIMEZONE=America/Sao_Paulo
LOG_LEVEL=INFO
